{
  "name": "pricedropp",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "typecheck": "pnpm -r typecheck",
    "prisma:generate": "pnpm -w --filter @pricedropp/db prisma:generate",
    "prisma:migrate": "pnpm -w --filter @pricedropp/db prisma:migrate",
    "seed": "pnpm -w --filter @pricedropp/db seed",
    "test": "pnpm -r test"
  }
}

